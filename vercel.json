{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "app.js",
          "style.css",
          "tracker.js",
          "express-integration.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/app.js",
      "dest": "/server.js"
    },
    {
      "src": "/style.css",
      "dest": "/server.js"
    },
    {
      "src": "/tracker.js",
      "dest": "/server.js"
    },
    {
      "src": "/express-integration.js",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
